{
  "private": true,
  "name": "browser-app",
  "version": "0.0.0",
  "dependencies": {
    "@theia/bulk-edit": "1.74.1",
    "@theia/console": "1.74.1",
    "@theia/core": "1.74.1",
    "@theia/debug": "1.74.1",
    "@theia/editor": "1.74.1",
    "@theia/file-search": "1.74.1",
    "@theia/filesystem": "1.74.1",
    "@theia/keymaps": "1.74.1",
    "@theia/markers": "1.74.1",
    "@theia/messages": "1.74.1",
    "@theia/mini-browser": "1.74.1",
    "@theia/monaco": "1.74.1",
    "@theia/navigator": "1.74.1",
    "@theia/outline-view": "1.74.1",
    "@theia/output": "1.74.1",
    "@theia/preferences": "1.74.1",
    "@theia/process": "1.74.1",
    "@theia/property-view": "1.74.1",
    "@theia/scm": "1.74.1",
    "@theia/search-in-workspace": "1.74.1",
    "@theia/task": "1.74.1",
    "@theia/terminal": "1.74.1",
    "@theia/workspace": "1.74.1",
    "clock-creator": "0.0.0",
    "drivelist": "^12.0.2"
  },
  "devDependencies": {
    "@theia/cli": "1.74.1",
    "terser-webpack-plugin": "^5.3.14"
  },
  "scripts": {
    "bundle": "npm run rebuild && theia build --mode development",
    "rebuild": "theia rebuild:browser --cacheRoot ..",
    "start": "theia start --hostname 127.0.0.1 --port 3000",
    "start:workspace": "theia start ../workspace --hostname 127.0.0.1 --port 3000",
    "start:app": "theia start .. --hostname 127.0.0.1 --port 3000",
    "watch": "npm run rebuild && theia build --watch --mode development"
  },
  "theia": {
    "target": "browser"
  }
}
