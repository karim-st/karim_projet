{
  "private": true,
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "scripts": {
    "build:browser": "npm --prefix browser-app run bundle",
    "build:electron": "npm --prefix electron-app run bundle",
    "prepare": "echo Run npm run build:extension after install",
    "build:extension": "npm --prefix clock-creator run build:css && npm --prefix clock-creator run build",
    "postinstall": "theia check:theia-version || echo theia-version-check-skipped",
    "start:browser": "npm --prefix browser-app start",
    "start:electron": "npm --prefix electron-app start",
    "watch:browser": "lerna run --parallel watch --scope clock-creator --scope browser-app",
    "watch:electron": "lerna run --parallel watch --scope clock-creator --scope electron-app",
    "test": "npm --prefix clock-creator test"
  },
  "devDependencies": {
    "lerna": "^8.2.4"
  },
  "workspaces": [
    "clock-creator",
    "browser-app"
  ],
