{
  "private": true,
  "engines": {
    "yarn": ">=1.7.0 <2.x.x",
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "husky install && yarn build",
    "build": "lerna run build --scope @prg-cube/*",
    "browser": "lerna run --scope browser-app",
    "electron": "lerna run --scope electron-app",
    "start:dev": "yarn browser rebuild && nodemon --watch ./ext yarn browser start",
    "watch": "lerna run --scope @prg-cube/* --scope browser-app --parallel watch",
    "watch:electron": "lerna run --scope @prg-cube/* --scope electron-app --parallel watch",
    "lint": "lerna run lint ",
    "lint:fix": "lerna run lint:fix ",
    "test": "lerna run test "
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
