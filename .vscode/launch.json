{
  // Use IntelliSense to learn about possible Node.js debug attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Start Browser Backend",
      "program": "${workspaceFolder}/browser-app/src-gen/backend/main.js",
      "args": [
        "--loglevel=debug",
        "--port=3000",
        "--no-cluster",
        "--app-project-path=${workspaceFolder}/browser-app"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/browser-app/src-gen/backend/*.js",
        "${workspaceFolder}/browser-app/lib/**/*.js",
        "${workspaceFolder}/ext/**/lib/**/*.js",
        "${workspaceFolder}/node_modules/@theia/*/lib/**/*.js",
        "${workspaceFolder}/node_modules/@eclipse-glsp/*/lib/**/*.js",
        "${workspaceFolder}/node_modules/@prg-cube/*/lib/**/*.js"
      ],
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart",
      "outputCapture": "std"
    },
    {
      "name": "Launch Browser Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000/",
      "webRoot": "${workspaceFolder}/browser-app"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Start Electron Backend",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "cwd": "${workspaceFolder}/electron-app",
      "protocol": "inspector",
      "args": [
        ".",
        "--log-level=debug",
        "--hostname=localhost",
        "--app-project-path=${workspaceFolder}/electron-app",
        "--remote-debugging-port=9222",
        "--allowMultipleWindows"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/electron-app/src-gen/backend/electron-main.js",
        "${workspaceFolder}/electron-app/src-gen/backend/main.js",
        "${workspaceFolder}/electron-app/lib/**/*.js",
        "${workspaceFolder}/ext/**/lib/**/*.js",
        "${workspaceFolder}/node_modules/@theia/*/lib/**/*.js",
        "${workspaceFolder}/node_modules/@eclipse-glsp/*/lib/**/*.js",
        "${workspaceFolder}/node_modules/@prg-cube/*/lib/**/*.js"
      ],
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart",
      "outputCapture": "std"
    },
    {
      "name": "Attach to Electron Frontend",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/electron-app"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Clock CheckerProgram",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}\\npm\\clockchecker\\build\\index.js",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "outFiles": ["${workspaceFolder}/npm/clockchecker/build/**/*.js"]
    }
  ]
}
